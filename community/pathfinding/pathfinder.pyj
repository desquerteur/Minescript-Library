        global currentnode
        
        


if __name__ == "__main__":
    start = Instant.now().toEpochMilli()
    get_path(end=target)
    end = Instant.now().toEpochMilli()
    print(f"Time taken: {end-start}ms")

    smallest = 999999
    p = []
    for path in target_paths:
        dist = len(path)
        if dist < smallest:
            p = path
            smallest = dist


    if len(p) > 0:
        print("Path length: "+str(len(p)))
    else:
        print("No suitable path found.")


    cache = []
    for node in p:
        x,y,z = node
        cache.append([x,y,z,x+1,y+1,z+1])

    #print(len(nodes))

    def on_render(event):
        #print(len(filling))
        for pair in cache:
           box = AABB(*pair)
           Gizmos.cuboid(box, filled).setAlwaysOnTop()


    def getclosedist(p1, p2):
        x1,y1,z1 = p1
        x2,y2,z2 = p2

        x = (x1-x2)
        z = (z1-z2)
        y = ((y1-y2))

        if y > 0: #if we go down
            y *= .8

        if y < -1: #going up more
            y *= 5000



        return ((x*x)+(y*y)+(z*z))**.5





    




    currentnode = 0
    follower_thread = add_event_listener("render",follower)
    add_event_listener("render",on_render)


