#!python
from minescript import *

List = JavaClass("java.util.List")
java_list = [1, 2, 3, 4, 5].getJavaList()

result = java_list.stream() \
    .filter(lambda x: x % 2 == 0) \
    .map(lambda x: x * x) \
    .toList()

echo(f"Even squares: {result}")
